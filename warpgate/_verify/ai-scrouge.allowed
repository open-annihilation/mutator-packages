# The import leaves ARMCOM and CORCOM at side 0, and the Scrouge's records at the sides they ship. This package locks SCROUGE and SCRGMEX at side 0, and its units hook writes side 10000 on the commanders Warp Gate marked
left only field units/armcom.fbi [unitinfo] side: ARM -> 10000
left only field units/corcom.fbi [unitinfo] side: CORE -> 10000
left only field units/scrgmex.fbi [unitinfo] side: (absent) -> 0
left only field units/scrouge.fbi [unitinfo] side: (absent) -> 0
right only field units/armcom.fbi [unitinfo] side: ARM -> 0
right only field units/corcom.fbi [unitinfo] side: CORE -> 0
right only field units/scrgmex.fbi [unitinfo] side: (absent) -> CORE
right only field units/scrouge.fbi [unitinfo] side: (absent) -> SCROUGE
